<% title = "#{ApplicationHelper::SITE_NAME} — Honest tool reviews, no hype" %>
<% description = "Independent reviews, head-to-head comparisons, and a daily journal of what actually works." %>
<% content_for :title, title %>
<% seo_tags title: title, description: description %>
<%= json_ld({ "@context": "https://schema.org", "@type": "WebSite", name: ApplicationHelper::SITE_NAME, url: root_url, description: description }) %>

<section class="py-16 sm:py-24">
  <h1 class="heading max-w-3xl text-4xl leading-tight sm:text-6xl">HypeBusted: tools tested, hype ignored.</h1>
  <p class="mt-6 max-w-2xl text-lg muted"><%= description %></p>
</section>

<% if [@comparisons, @reviews, @journal].all?(&:empty?) %>
  <p class="pb-24 muted">Nothing published yet. Check back soon.</p>
<% end %>

<% if @comparisons.any? %>
  <section id="comparisons" class="pb-20" aria-labelledby="comparisons-heading">
    <h2 id="comparisons-heading" class="heading text-2xl sm:text-3xl">Comparisons</h2>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      <% @comparisons.each do |post| %>
        <article class="card card-feature card-press group">
          <p class="eyebrow"><%= time_tag_for(post.published_at, "%b %-d, %Y") %></p>
          <h3 class="heading mt-4 text-2xl leading-snug sm:text-3xl"><%= link_to post.title, post_path(post.slug), class: "stretched-link" %></h3>
          <%= render "posts/tags", post: post %>
          <div class="card-cta" aria-hidden="true">Read comparison <span class="cta-circle cta-nudge"><%= link_icon(:arrow, class: "size-5") %></span></div>
        </article>
      <% end %>
    </div>
  </section>
<% end %>

<% if @reviews.any? %>
  <section id="reviews" class="pb-20" aria-labelledby="reviews-heading">
    <h2 id="reviews-heading" class="heading text-xl">Reviews</h2>
    <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <% @reviews.each do |post| %>
        <article class="card card-press card-review group">
          <p class="eyebrow"><%= time_tag_for(post.published_at, "%b %-d, %Y") %></p>
          <h3 class="mt-3 text-lg font-semibold leading-snug"><%= link_to post.title, post_path(post.slug), class: "stretched-link" %></h3>
          <%= render "posts/tags", post: post %>
          <p class="card-cta-sm" aria-hidden="true">Read review <%= link_icon(:arrow, class: "cta-nudge size-4") %></p>
        </article>
      <% end %>
    </div>
  </section>
<% end %>

<% if @journal.any? %>
  <section id="journal" class="pb-24" aria-labelledby="journal-heading">
    <h2 id="journal-heading" class="eyebrow tracking-widest">Journal</h2>
    <div class="mt-3 divide-y divide-ink/10">
      <% @journal.each do |post| %>
        <article class="card group flex-row items-center justify-between gap-4 rounded-none border-0 bg-transparent px-0 py-2.5 active:bg-ink/5">
          <h3 class="flex-1 text-base"><%= link_to post.title, post_path(post.slug), class: "stretched-link" %></h3>
          <%= time_tag_for(post.published_at, "%b %-d", class: "eyebrow shrink-0") %>
          <%= link_icon(:chevron, class: "row-chevron size-4") %>
        </article>
      <% end %>
    </div>
  </section>
<% end %>
