<header class="border-b border-ink/10">
  <div class="page flex items-center justify-between py-5">
    <%= link_to root_path, class: "block" do %>
      <%= image_tag "logo/hypebusted-header-on-light.svg", alt: ApplicationHelper::SITE_NAME, class: "h-9 w-auto" %>
    <% end %>
    <nav aria-label="Main" class="flex gap-5 text-sm muted">
      <a href="/#comparisons">Comparisons</a>
      <a href="/#reviews">Reviews</a>
      <a href="/#journal">Journal</a>
      <% if super_admin_signed_in? %>
        <%= link_to "Admin", avo_path, data: { turbo: false } %>
      <% end %>
    </nav>
  </div>
</header>
