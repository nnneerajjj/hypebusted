# Bundler and installed dependencies.
/.bundle
/vendor/bundle
/vendor/ruby
/vendor/cache
/node_modules

# Local environment variables (keep a safe example template).
/.env*
!/.env.example

# Logs and temporary files.
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Local uploads and SQLite databases.
/storage/*
!/storage/.keep
/db/*.sqlite3
/db/*.sqlite3-*

# Compiled frontend assets.
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets
/public/packs
/public/packs-test
/coverage

# Rails credentials and other private keys.
/config/*.key
/config/credentials/*.key

# Local development artifacts.
/.byebug_history
.DS_Store
*.swp
*~
